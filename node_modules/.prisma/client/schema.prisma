datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Main table for all doc
model Document {
  /// Auto-incrementing primary key:
  id       Int    @id @default(autoincrement())
  fileUrl  String
  /// The original PDF filename (e.g. "MBL1234.pdf"):
  filename String

  uploadedAt DateTime @default(now())

  rawJson Json
  /// A JSON  that holds the entire AI‐returned object in one field:

  filetype String
  /// mbl, hbl ...etc

  fileid String
}

/// *****************************************************
/// 2) Tables for each nested object (1:1 with Document)
/// *****************************************************

model ShipperInfo {
  id             Int    @id @default(autoincrement())
  shipperName    String
  shipperAddress String
  shipperCity    String
  shipperState   String
  shipperCountry String

  // Back‐reference to the parent document
  documentId Int @unique
}

model ConsigneeInfo {
  id               Int    @id @default(autoincrement())
  consigneeName    String
  consigneeAddress String
  consigneeCity    String
  consigneeState   String
  consigneeCountry String
  consigneePostal  String

  documentId Int @unique
}

model NotifyInfo {
  id                 Int    @id @default(autoincrement())
  notifyPartyName    String
  notifyPartyAddress String
  notifyPartyCity    String
  notifyPartyState   String
  notifyPartyCountry String
  notifyPartyPostal  String

  documentId Int @unique
}

model ShipmentVesselInfo {
  id                       Int       @id @default(autoincrement())
  masterBillOfLadingNumber String
  carrierScacCode          String
  carrierBookingNumber     String
  vesselName               String
  voyageNumber             String
  portOfLoading            String
  portOfDischarge          String
  placeOfReceipt           String
  placeOfDelivery          String
  placeOfRelease           String
  dateOfRelease            DateTime?
  shippedOnBoardDate       DateTime?

  documentId Int
}

model LogisticsFreightDetails {
  id             Int    @id @default(autoincrement())
  mode           String
  freightTerm    String
  freightService String

  documentId Int
}

model SummaryMetrics {
  id                      Int    @id @default(autoincrement())
  totalNumberOfContainers Int?
  totalWeight             Float?
  totalVolume             Float?
  totalPackage            Int?

  documentId Int
}

/// *****************************************************
/// 3)(one row per record)
/// *****************************************************

model FreightCharge {
  id         Int    @id @default(autoincrement())
  chargeName String
  rate       Float?
  quantity   Int?
  amount     Float?
  prepaid    Float?
  collect    Float?

  // Foreign key back to Document
  documentId Int
}

model Container {
  id                     Int     @id @default(autoincrement())
  containerNumber        String
  sealNumber             String
  containerType          String
  numberOfPackages       Int?
  packageUom             String?
  weight                 Float?
  weightUom              String?
  volume                 Float?
  volumeUom              String?
  productItemDescription String
  productItemHscode      String

  documentId Int
}
